<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXComboBox?>
<?import io.github.palexdev.materialfx.controls.MFXPasswordField?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      stylesheets="@css/style.css"
      styleClass="app-root form-root"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns:mfx="http://materialfx.dev/fxml"
      fx:controller="com.app.client.controller.UserFormController">

    <VBox spacing="4" styleClass="card page-card">
        <padding>
            <Insets top="18" right="20" bottom="18" left="20"/>
        </padding>
        <Label text="Użytkownik" styleClass="section-title"/>
        <Label text="Dodaj lub edytuj konto w jednym MaterialFX formularzu." styleClass="muted-text"/>
    </VBox>

    <VBox spacing="16" styleClass="card form-card">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <GridPane hgap="12" vgap="12" styleClass="form-grid">
            <Label text="ID" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
            <MFXTextField fx:id="idField"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1"
                          editable="false"
                          promptText="Auto"
                          styleClass="input-field"/>

            <Label text="Login" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
            <MFXTextField fx:id="loginField"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"
                          promptText="login"
                          styleClass="input-field"/>

            <Label text="Hasło" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
            <MFXPasswordField fx:id="passwordField"
                              GridPane.rowIndex="2"
                              GridPane.columnIndex="1"
                              promptText="nowe hasło"
                              styleClass="input-field"/>

            <Label text="Nazwa wyświetlana" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
            <MFXTextField fx:id="fullNameField"
                          GridPane.rowIndex="3"
                          GridPane.columnIndex="1"
                          promptText="imię i nazwisko"
                          styleClass="input-field"/>

            <Label text="Email" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
            <MFXTextField fx:id="emailField"
                          GridPane.rowIndex="4"
                          GridPane.columnIndex="1"
                          promptText="email"
                          styleClass="input-field"/>

            <Label text="Rola" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="field-label"/>
            <MFXComboBox fx:id="roleCombo"
                         GridPane.rowIndex="5"
                         GridPane.columnIndex="1"
                         prefWidth="220"
                         styleClass="input-field"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <MFXButton text="Zapisz" onAction="#onSave" styleClass="btn btn-primary"/>
            <MFXButton text="Anuluj" onAction="#onCancel" styleClass="btn btn-secondary"/>
        </HBox>
    </VBox>

</VBox>
