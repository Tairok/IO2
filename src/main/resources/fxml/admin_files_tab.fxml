<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16"
      stylesheets="@css/style.css"
      styleClass="card tab-card"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns:mfx="http://materialfx.dev/fxml"
      fx:controller="com.app.client.controller.AdminFilesController">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <VBox spacing="4">
        <Label text="Pliki wszystkich użytkowników" styleClass="section-title"/>
        <Label text="Przeglądaj, pobieraj i usuwaj pliki dowolnego użytkownika." styleClass="muted-text"/>
    </VBox>

    <TableView fx:id="fileTable" VBox.vgrow="ALWAYS" styleClass="table-view table-surface">
        <columns>
            <TableColumn fx:id="colUser" text="Użytkownik" prefWidth="120"/>
            <TableColumn fx:id="colName" text="Plik" prefWidth="220"/>
            <TableColumn fx:id="colSize" text="Rozmiar" prefWidth="120"/>
            <TableColumn fx:id="colDate" text="Zmodyfikowany" prefWidth="160"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <MFXButton text="Odśwież" onAction="#onRefresh" styleClass="btn btn-info"/>
        <MFXButton text="Pobierz" onAction="#onDownload" styleClass="btn btn-primary"/>
        <MFXButton text="Usuń" onAction="#onDelete" styleClass="btn btn-danger"/>
    </HBox>

</VBox>
