<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane stylesheets="@css/style.css"
            styleClass="app-root main-container"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns:mfx="http://materialfx.dev/fxml"
            fx:controller="com.app.client.controller.AdminPanelController">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card top-bar">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>

            <Label fx:id="welcomeLabel" text="Panel administratora" styleClass="hero-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <MFXButton text="Wyloguj" onAction="#handleLogout" styleClass="btn btn-danger"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" styleClass="surface-card">
            <tabs>
                <Tab text="Użytkownicy" closable="false">
                    <fx:include source="user_tab.fxml"/>
                </Tab>
                <Tab text="Pliki użytkowników" closable="false">
                    <fx:include source="admin_files_tab.fxml"/>
                </Tab>
            </tabs>
        </TabPane>
    </center>

</BorderPane>
