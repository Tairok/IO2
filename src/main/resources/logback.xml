<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level [%thread] %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CLIENT_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/client.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="SERVER_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/server.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.app.client" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="CLIENT_FILE"/>
    </logger>

    <logger name="com.app.server" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="SERVER_FILE"/>
    </logger>

    <root level="info">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
